{
	"name": "@ews/api",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=../../.env src/server.ts",
		"build": "tsup",
		"start": "node --env-file-if-exists=../../.env dist/server.js",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"auth:generate": "npx @better-auth/cli generate --config src/features/auth/auth.config.ts --output src/features/auth/auth.schema.ts"
	},
	"dependencies": {
		"@ews/shared": "workspace:*",
		"@fastify/cors": "^11.3.1",
		"@fastify/swagger": "^9.9.2",
		"@fastify/swagger-ui": "^6.1.2",
		"@fastify/websocket": "^11.3.4",
		"better-auth": "^1.7.7",
		"bullmq": "^6.3.12",
		"drizzle-orm": "^0.45.4",
		"fastify": "^5.12.5",
		"fastify-plugin": "^6.0.1",
		"fastify-type-provider-zod": "^7.0.0",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1",
		"zod": "^4.6.6"
	},
	"devDependencies": {
		"@ews/tsconfig": "workspace:*",
		"@testcontainers/postgresql": "^11.14.0",
		"@types/node": "^24.13.3",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"pino-pretty": "^13.2.0",
		"testcontainers": "^11.14.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10"
	}
}
